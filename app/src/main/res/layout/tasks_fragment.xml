<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="dev.kxxcn.maru.view.tasks.TasksViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/maru_paper">

        <dev.kxxcn.maru.view.custom.MaruTextView
            android:id="@+id/tasks_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:text="@string/menu_tasks"
            android:textAppearance="@style/TextAppearance.Maru.ScreenTitle"
            app:layout_constraintEnd_toStartOf="@id/tasks_edit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textStyle="bold" />

        <dev.kxxcn.maru.view.custom.MaruTextView
            android:id="@+id/tasks_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@{@string/tasks_completed_summary(viewModel.totalCount, viewModel.completedCount)}"
            android:textAppearance="@style/TextAppearance.Maru.Meta"
            app:layout_constraintEnd_toEndOf="@id/tasks_title"
            app:layout_constraintStart_toStartOf="@id/tasks_title"
            app:layout_constraintTop_toBottomOf="@id/tasks_title"
            tools:text="18개 중 5개 완료" />

        <ImageView
            android:id="@+id/tasks_edit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/tasks_sort"
            android:onClick="@{() -> viewModel.edit()}"
            android:padding="10dp"
            android:src="@drawable/ic_sort"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/maru_ink" />

        <ProgressBar
            android:id="@+id/tasks_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            android:max="100"
            android:progress="@{viewModel.progressPercent}"
            android:progressDrawable="@drawable/progress_done"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tasks_subtitle" />

        <dev.kxxcn.maru.view.custom.SegmentView
            android:id="@+id/tasks_segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tasks_progress" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tasks_list"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="120dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tasks_segment"
            app:tasks="@{viewModel.tasks}" />

        <ImageView
            android:id="@+id/tasks_add"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_fab"
            android:contentDescription="@string/tasks_add"
            android:elevation="8dp"
            android:onClick="@{() -> viewModel.add()}"
            android:padding="16dp"
            android:src="@drawable/ic_add"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/maru_paper" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
