<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="stringRes"
            type="Integer" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_tile_active"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_tasks"
            app:tint="@color/maru_yellow_ink" />

        <dev.kxxcn.maru.view.custom.MaruTextView
            android:id="@+id/empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@{stringRes != null ? context.getString(stringRes) : ``}"
            android:textColor="@color/maru_ink_2"
            android:textSize="15sp" />

    </LinearLayout>

</layout>
