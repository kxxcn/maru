<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:minWidth="132dp"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <dev.kxxcn.maru.view.custom.MaruTextView
        android:id="@+id/chip_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/maru_ink"
        android:textSize="22sp"
        app:textStyle="bold" />

    <dev.kxxcn.maru.view.custom.MaruTextView
        android:id="@+id/chip_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="160dp"
        android:textColor="@color/maru_ink_2"
        android:textSize="12.5sp" />

    <dev.kxxcn.maru.view.custom.MaruTextView
        android:id="@+id/chip_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="@color/maru_muted"
        android:textSize="12sp" />

</LinearLayout>
