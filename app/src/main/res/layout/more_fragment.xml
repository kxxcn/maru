<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="dev.kxxcn.maru.util.ConvertUtils" />

        <import type="dev.kxxcn.maru.view.present.PresentFilterType" />

        <variable
            name="viewModel"
            type="dev.kxxcn.maru.view.more.MoreViewModel" />
    </data>

    <ScrollView
        android:id="@+id/maru_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/maru_paper"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <dev.kxxcn.maru.view.custom.MaruTextView
            android:id="@+id/more_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_more"
            android:textAppearance="@style/TextAppearance.Maru.ScreenTitle"
            app:textStyle="bold" />

        <LinearLayout
            android:id="@+id/more_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:onClick="@{() -> viewModel.settings()}"
            android:orientation="horizontal"
            android:padding="16dp">

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_fab"
                android:backgroundTint="@color/maru_yellow"
                android:gravity="center"
                android:text="@{viewModel.summary.user.name.length() > 0 ? viewModel.summary.user.name.substring(0, 1) : ``}"
                android:textColor="@color/maru_on_yellow"
                android:textSize="20sp"
                app:textStyle="bold"
                tools:text="수" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <dev.kxxcn.maru.view.custom.MaruTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{viewModel.summary.user.name}"
                    android:textColor="@color/maru_ink"
                    android:textSize="16sp"
                    app:textStyle="bold"
                    tools:text="수민" />

                <dev.kxxcn.maru.view.custom.MaruTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@{@string/more_profile_summary(viewModel.summary.weddingDateShort, ConvertUtils.INSTANCE.moneyText(viewModel.summary.user.budget))}"
                    android:textAppearance="@style/TextAppearance.Maru.Meta"
                    tools:text="2027년 1월 23일, 예산 1억 2,000만원" />

            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/maru_muted" />

        </LinearLayout>

        <dev.kxxcn.maru.view.custom.MaruTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="6dp"
            android:letterSpacing="0.02"
            android:text="@string/more_group_guide"
            android:textColor="@color/maru_muted"
            android:textSize="12.5sp"
            app:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-4dp"
            android:layout_marginEnd="-4dp"
            android:columnCount="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_card"
                android:onClick="@{() -> viewModel.timeline()}"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_tile_ready"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_contents_timeline" />

                <dev.kxxcn.maru.view.custom.MaruTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/more_contents_timeline"
                    android:textColor="@color/maru_ink"
                    android:textSize="13.5sp"
                    app:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_card"
                android:onClick="@{() -> viewModel.order()}"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_tile_ready"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_contents_order" />

                <dev.kxxcn.maru.view.custom.MaruTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/more_contents_order"
                    android:textColor="@color/maru_ink"
                    android:textSize="13.5sp"
                    app:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_card"
                android:onClick="@{() -> viewModel.present(PresentFilterType.DRESS)}"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_tile_ready"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_contents_dress" />

                <dev.kxxcn.maru.view.custom.MaruTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/more_contents_dress"
                    android:textColor="@color/maru_ink"
                    android:textSize="13.5sp"
                    app:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_card"
                android:onClick="@{() -> viewModel.present(PresentFilterType.TUXEDO)}"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_tile_ready"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_contents_tuxedo" />

                <dev.kxxcn.maru.view.custom.MaruTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/more_contents_tuxedo"
                    android:textColor="@color/maru_ink"
                    android:textSize="13.5sp"
                    app:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_card"
                android:onClick="@{() -> viewModel.present(PresentFilterType.HANBOK)}"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_tile_ready"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_contents_hanbok" />

                <dev.kxxcn.maru.view.custom.MaruTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/more_contents_hanbok"
                    android:textColor="@color/maru_ink"
                    android:textSize="13.5sp"
                    app:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_card"
                android:onClick="@{() -> viewModel.present(PresentFilterType.RING)}"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_tile_ready"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_contents_ring" />

                <dev.kxxcn.maru.view.custom.MaruTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/more_contents_ring"
                    android:textColor="@color/maru_ink"
                    android:textSize="13.5sp"
                    app:textStyle="bold" />

            </LinearLayout>

        </GridLayout>

        <dev.kxxcn.maru.view.custom.MaruTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="6dp"
            android:letterSpacing="0.02"
            android:text="@string/more_group_tools"
            android:textColor="@color/maru_muted"
            android:textSize="12.5sp"
            app:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:onClick="@{() -> viewModel.days()}"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_contents_event" />

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/more_contents_event"
                android:textColor="@color/maru_ink"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/maru_muted" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/maru_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:onClick="@{() -> viewModel.landmark()}"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_contents_landmark" />

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/more_contents_landmark"
                android:textColor="@color/maru_ink"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/maru_muted" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/maru_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:onClick="@{() -> viewModel.backup()}"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_contents_backup" />

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/more_contents_backup"
                android:textColor="@color/maru_ink"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/maru_muted" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/maru_line" />

        <LinearLayout
            android:id="@+id/more_premium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card_yellow_tint"
            android:gravity="center_vertical"
            android:onClick="@{() -> viewModel.premium()}"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_contents_ad" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <dev.kxxcn.maru.view.custom.MaruTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{viewModel.isPremium ? @string/more_premium_active : @string/more_premium_title}"
                    android:textColor="@color/maru_ink"
                    android:textSize="14.5sp"
                    app:textStyle="bold"
                    tools:text="프리미엄" />

                <dev.kxxcn.maru.view.custom.MaruTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/more_premium_desc"
                    android:textColor="@color/maru_ink_2"
                    android:textSize="12.5sp" />

            </LinearLayout>

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/more_premium_price"
                android:textColor="@color/maru_ink"
                android:textSize="17sp"
                android:visibility="@{viewModel.isPremium ? View.GONE : View.VISIBLE}"
                app:textStyle="bold" />

        </LinearLayout>

        <dev.kxxcn.maru.view.custom.MaruTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="6dp"
            android:letterSpacing="0.02"
            android:text="@string/more_group_app"
            android:textColor="@color/maru_muted"
            android:textSize="12.5sp"
            app:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:onClick="@{() -> viewModel.setNight(!viewModel.useDarkMode)}"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_contents_night" />

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/more_contents_night"
                android:textColor="@color/maru_ink"
                android:textSize="15sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/more_night_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="@{viewModel.useDarkMode}"
                android:onCheckedChanged="@{(v, checked) -> viewModel.setNight(checked)}"
                app:thumbTint="@color/maru_surface"
                app:trackTint="@color/sel_switch_track" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/maru_line" />

        <LinearLayout
            android:id="@+id/more_setting"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:onClick="@{() -> viewModel.settings()}"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings" />

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/more_settings"
                android:textColor="@color/maru_ink"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/maru_muted" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/maru_line" />

        <LinearLayout
            android:id="@+id/more_notice"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:onClick="@{() -> viewModel.notice()}"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_notice" />

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/more_notice"
                android:textColor="@color/maru_ink"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/maru_muted" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/maru_line" />

        <LinearLayout
            android:id="@+id/more_contact"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:onClick="@{() -> viewModel.contact()}"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_email" />

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/more_contact"
                android:textColor="@color/maru_ink"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/maru_muted" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/maru_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:onClick="@{() -> viewModel.review()}"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_contents_review" />

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/more_contents_review"
                android:textColor="@color/maru_ink"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/maru_muted" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/maru_line" />

        <FrameLayout
            android:id="@+id/more_native_ad_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:visibility="@{viewModel.isPremium ? View.GONE : View.VISIBLE}" />

    </LinearLayout>

    </ScrollView>

</layout>
