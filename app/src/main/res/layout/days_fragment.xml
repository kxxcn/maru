<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="dev.kxxcn.maru.view.days.DaysViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/maru_paper">

        <ImageView
            android:id="@+id/back_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:contentDescription="@string/cancel"
            android:onClick="@{() -> viewModel.close()}"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_left"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/maru_ink" />

        <ImageView
            android:id="@+id/days_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/home_days_add"
            android:onClick="@{() -> viewModel.add()}"
            android:padding="10dp"
            android:src="@drawable/ic_add"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/maru_ink" />

        <dev.kxxcn.maru.view.custom.MaruTextView
            android:id="@+id/days_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:text="@string/more_contents_event"
            android:textAppearance="@style/TextAppearance.Maru.ScreenTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/back_icon"
            app:textStyle="bold" />

        <dev.kxxcn.maru.view.custom.MaruTextView
            android:id="@+id/days_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/days_subtitle"
            android:textAppearance="@style/TextAppearance.Maru.Meta"
            app:layout_constraintStart_toStartOf="@id/days_title"
            app:layout_constraintTop_toBottomOf="@id/days_title" />

        <LinearLayout
            android:id="@+id/days_wedding"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_card_yellow"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/days_subtitle">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <dev.kxxcn.maru.view.custom.MaruTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wedding"
                    android:textColor="@color/maru_on_yellow"
                    android:textSize="15sp"
                    app:textStyle="bold" />

                <dev.kxxcn.maru.view.custom.MaruTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:alpha="0.75"
                    android:text="@{viewModel.summary.weddingDateText}"
                    android:textColor="@color/maru_on_yellow"
                    android:textSize="12.5sp"
                    tools:text="2027년 1월 23일 토요일" />

            </LinearLayout>

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="-0.02"
                android:text="@{viewModel.summary.weddingPassed ? @string/home_dday_passed : (viewModel.summary.weddingRemainDays > 0 ? @string/home_dday_format(viewModel.summary.weddingRemainDays) : @string/home_dday_today)}"
                android:textColor="@color/maru_on_yellow"
                android:textSize="@{viewModel.summary.weddingPassed ? 20f : 46f}"
                app:textStyle="bold"
                tools:text="D-129" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/days_list"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
            app:daysList="@{viewModel.days}"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/days_wedding" />

        <LinearLayout
            android:id="@+id/days_empty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:visibility="@{viewModel.isEmpty ? View.VISIBLE : View.GONE}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/days_wedding">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_tile_active"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_contents_event" />

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:id="@+id/empty_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/home_day_card_management_schedule"
                android:textColor="@color/maru_ink"
                android:textSize="15.5sp"
                app:textStyle="bold" />

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/days_empty_desc"
                android:textColor="@color/maru_muted"
                android:textSize="13sp" />

            <Button
                style="@style/Widget.Maru.Button.Ink"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="18dp"
                android:minHeight="44dp"
                android:onClick="@{() -> viewModel.add()}"
                android:text="@string/home_days_add"
                android:textSize="14sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
