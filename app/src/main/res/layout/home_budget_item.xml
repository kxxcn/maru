<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="dev.kxxcn.maru.util.ConvertUtils" />

        <variable
            name="content"
            type="dev.kxxcn.maru.data.Summary" />

        <variable
            name="viewModel"
            type="dev.kxxcn.maru.view.home.HomeViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="26dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_budget_title"
                android:textAppearance="@style/TextAppearance.Maru.SectionTitle" />

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:id="@+id/home_budget_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="@{() -> viewModel.tasks()}"
                android:padding="4dp"
                android:text="@string/home_budget_detail"
                android:textColor="@color/maru_muted"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:id="@+id/home_budget_used"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="-0.01"
                android:text="@{ConvertUtils.INSTANCE.moneyText(content.totalAccounts)}"
                android:textColor="@color/maru_ink"
                android:textSize="34sp"
                app:textStyle="bold"
                tools:text="4,700만원" />

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="7dp"
                android:text="@{@string/home_budget_of(ConvertUtils.INSTANCE.moneyText(content.user.budget))}"
                android:textColor="@color/maru_muted"
                android:textSize="13.5sp"
                tools:text="/ 1억 2,000만원" />

        </LinearLayout>

        <dev.kxxcn.maru.view.custom.SplitBarView
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="14dp"
            app:brideRatio="@{content.brideBudgetRatio}"
            app:groomRatio="@{content.groomBudgetRatio}" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_groom" />

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@{@string/home_groom_amount(ConvertUtils.INSTANCE.moneyText(content.husbandAccounts))}"
                android:textColor="@color/maru_ink_2"
                android:textSize="12.5sp"
                tools:text="신랑 2,681만원" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/dot_bride" />

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@{@string/home_bride_amount(ConvertUtils.INSTANCE.moneyText(content.wifeAccounts))}"
                android:textColor="@color/maru_ink_2"
                android:textSize="12.5sp"
                tools:text="신부 2,019만원" />

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@{@string/home_budget_remaining(ConvertUtils.INSTANCE.moneyText(content.user.budget - content.totalAccounts))}"
                android:textColor="@color/maru_muted"
                android:textSize="12.5sp"
                tools:text="남은 7,300만원" />

        </LinearLayout>

    </LinearLayout>

</layout>
