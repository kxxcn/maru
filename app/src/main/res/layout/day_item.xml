<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="dev.kxxcn.maru.util.DateUtils" />

        <import type="dev.kxxcn.maru.view.days.DaysFilterType" />

        <variable
            name="day"
            type="dev.kxxcn.maru.data.Day" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <dev.kxxcn.maru.view.custom.MaruTextView
                        android:id="@+id/day_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{day.content}"
                        android:textColor="@color/maru_ink"
                        android:textSize="15.5sp"
                        app:textStyle="bold"
                        tools:text="웨딩 촬영" />

                    <dev.kxxcn.maru.view.custom.MaruTextView
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/days_add_count"
                        android:textColor="@color/maru_muted"
                        android:textSize="11sp"
                        android:visibility="@{day.type == DaysFilterType.COUNT ? View.VISIBLE : View.GONE}" />

                </LinearLayout>

                <dev.kxxcn.maru.view.custom.MaruTextView
                    android:id="@+id/day_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@{DateUtils.INSTANCE.DATE_FORMAT_7.format(day.date)}"
                    android:textAppearance="@style/TextAppearance.Maru.Meta"
                    tools:text="2026년 10월 24일 토요일" />

            </LinearLayout>

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:id="@+id/day_remain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="-0.01"
                android:maxLines="1"
                android:textSize="27sp"
                app:days="@{day}"
                app:textStyle="bold"
                tools:text="D-38" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/maru_line" />

    </LinearLayout>

</layout>
