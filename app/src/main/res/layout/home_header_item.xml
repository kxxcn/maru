<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="content"
            type="dev.kxxcn.maru.data.Summary" />

        <variable
            name="viewModel"
            type="dev.kxxcn.maru.view.home.HomeViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="14dp">

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:id="@+id/home_greeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@{@string/home_greeting(content.user.name)}"
                android:textColor="@color/maru_ink_2"
                android:textSize="15sp"
                tools:text="수민님, 안녕하세요" />

            <ImageView
                android:id="@+id/home_notice"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/more_notice"
                android:onClick="@{() -> viewModel.notice()}"
                android:padding="10dp"
                android:src="@drawable/ic_notice"
                app:tint="@color/maru_ink" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_dday_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_yellow"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:text="@{content.weddingPassed ? @string/home_dday_passed : @string/home_dday_label}"
                android:textColor="@color/maru_on_yellow"
                android:textSize="14sp"
                tools:text="결혼식까지" />

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:id="@+id/home_dday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="-0.02"
                android:text="@{content.weddingRemainDays > 0 ? @string/home_dday_format(content.weddingRemainDays) : @string/home_dday_today}"
                android:textColor="@color/maru_on_yellow"
                android:textSize="68sp"
                android:visibility="@{content.weddingPassed ? View.GONE : View.VISIBLE}"
                app:textStyle="bold"
                tools:text="D-129" />

            <dev.kxxcn.maru.view.custom.MaruTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@{content.weddingDateText}"
                android:textColor="@color/maru_on_yellow"
                android:textSize="14sp"
                tools:text="2027년 1월 23일 토요일" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="@{content.taskProgressPercent}"
                    android:progressDrawable="@drawable/progress_on_yellow" />

                <dev.kxxcn.maru.view.custom.MaruTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@{@string/home_progress_summary(content.completedTasksCount, content.totalTasksCount)}"
                    android:textColor="@color/maru_on_yellow"
                    android:textSize="12.5sp"
                    tools:text="체크리스트 5/18 완료" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</layout>
