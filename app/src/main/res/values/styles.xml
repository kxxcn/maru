<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/maru_yellow</item>
        <item name="colorPrimaryDark">@color/maru_paper</item>
        <item name="colorAccent">@color/maru_yellow</item>
        <item name="android:windowBackground">@color/maru_paper</item>
        <item name="android:textColorPrimary">@color/maru_ink</item>
        <item name="android:textColorSecondary">@color/maru_ink_2</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- 버튼 -->
    <style name="Widget.Maru.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Widget.Maru.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/maru_on_yellow</item>
    </style>
    <style name="Widget.Maru.Button.Ghost">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/maru_ink</item>
    </style>
    <style name="Widget.Maru.Button.Ink">
        <item name="android:background">@drawable/bg_button_ink</item>
        <item name="android:textColor">@color/maru_paper</item>
    </style>
    <style name="Widget.Maru.Chip" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/maru_ink_2</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Widget.Maru.Key" parent="TextAppearance.AppCompat">
        <item name="android:layout_height">46dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/maru_ink</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 글자 -->
    <style name="TextAppearance.Maru.ScreenTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/maru_ink</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.Maru.SectionTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/maru_ink</item>
    </style>
    <style name="TextAppearance.Maru.Body" parent="TextAppearance.AppCompat">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/maru_ink</item>
    </style>
    <style name="TextAppearance.Maru.Meta" parent="TextAppearance.AppCompat">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/maru_muted</item>
    </style>
    <style name="TextAppearance.Maru.Amount" parent="TextAppearance.AppCompat">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/maru_ink</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- 하단 시트 -->
    <style name="Animation.Maru.Sheet" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>
    <style name="Theme.Maru.Sheet" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowAnimationStyle">@style/Animation.Maru.Sheet</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

</resources>
